{
  "image": {
    "idyl": "python-3.12-ubuntu-24.04"
  },
  "cpu": "2",
  "network": {
    "class": "restricted-egress",
    "egress": {
      "allow": [
        "dns",
        "tcp:443:pypi.example.com"
      ],
      "denyLocalNetworks": true
    }
  },
  "setVariables": [
    {
      "name": "LOG_LEVEL",
      "value": "debug"
    }
  ],
  "removeVariables": [
    "EMPTY"
  ],
  "client": "console"
}
